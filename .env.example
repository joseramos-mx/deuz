# Copiar a .env.local y completar. No subir valores reales al repositorio.

# Webhook de n8n que recibe cada lead del cotizador (CRM, aviso al director, seguimiento).
# Si responde JSON con { "folio": "DEUZ-2026-0142" }, ese folio consecutivo reemplaza al generado.
LEAD_WEBHOOK_URL=

# URL pública de la agenda (Cal.com o similar) para "Agendar visita técnica" y "Hablar con un director".
NEXT_PUBLIC_CAL_URL=

# WhatsApp del director, solo dígitos con lada de país. Ej. 526181234567
NEXT_PUBLIC_WHATSAPP_DIRECTOR=

# true = mostrar rangos en MXN en el cotizador (solo si src/data/costos.js tiene costos validados).
MOSTRAR_MONTOS=false

# Dominio de producción para metadatos, sitemap y OG. Ej. https://deuzmx.com
NEXT_PUBLIC_SITE_URL=
